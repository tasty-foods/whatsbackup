{
  "name": "whatsbackup",
  "productName": "WhatsBackUp",
  "version": "2.2.0",
  "private": true,
  "description": "Saves WhatsApp media and messages, imports ChatGPT, Gemini and Google Photos media, and copies media to your cloud folder.",
  "author": {
    "name": "Tasty Foods",
    "email": "info@tasty-foods.be"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node src/index.js",
    "icons": "node tools/make-icons.js",
    "og": "node tools/make-og.js",
    "fetch-chrome": "node tools/fetch-chrome.js",
    "prepack": "npm run icons && npm run fetch-chrome",
    "dist": "npm run prepack && electron-builder --win --publish never",
    "release": "npm run prepack && electron-builder --win --publish always",
    "verify-release": "node tools/verify-desktop-release.cjs",
    "backfill": "node src/backfill.js",
    "reset": "node src/reset.js",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "archiver": "^7.0.1",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "fflate": "0.8.3",
    "ffmpeg-static": "5.3.0",
    "pdfjs-dist": "6.4.299",
    "qrcode": "^1.5.4",
    "sharp": "0.35.5",
    "whatsapp-web.js": "github:wwebjs/whatsapp-web.js#064a3d5a5a3dce1281a6a12740b5a7051339d154"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "be.tastyfoods.whatsbackup",
    "productName": "WhatsBackUp",
    "copyright": "Copyright © 2026 Tasty Foods",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/**/{test,__tests__,docs,example,examples}/**"
    ],
    "extraResources": [
      {
        "from": "build/chromium",
        "to": "chromium"
      },
      {
        "from": "build/icons",
        "to": "icons"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "WhatsBackUp-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WhatsBackUp",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tasty-foods",
        "repo": "whatsbackup"
      }
    ]
  }
}
